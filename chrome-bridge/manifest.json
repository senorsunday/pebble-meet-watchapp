{
  "manifest_version": 3,
  "name": "PebbleMeet Browser Bridge",
  "version": "0.2.0",
  "description": "Pairs your Pebble smartwatch with Google Meet via a Cloudflare Durable Object relay for mute, camera, raise hand, captions, chat dictation, and inviting contacts.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PebbleMeet Bridge"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
