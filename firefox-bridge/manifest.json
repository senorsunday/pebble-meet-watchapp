{
  "manifest_version": 3,
  "name": "PebbleMeet Browser Bridge (Firefox)",
  "version": "0.2.0",
  "description": "Pairs your Pebble smartwatch with Google Meet on Firefox Desktop and Firefox for Android via a Cloudflare Durable Object relay.",
  "browser_specific_settings": {
    "gecko": {
      "id": "pebblemeet-bridge@senorsunday.github.io",
      "strict_min_version": "109.0"
    },
    "gecko_android": {
      "strict_min_version": "120.0"
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PebbleMeet Bridge"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
